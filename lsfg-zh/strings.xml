    <string name="gpu_method_deband">去色带</string>
    <string name="param_gpu_upscale">GPU 放大倍率</string>
    <string name="param_gpu_upscale_desc">控制支持缩放的方法所使用的输出倍率。</string>
    <string name="param_gpu_sharpness">GPU 锐化</string>
    <string name="param_gpu_sharpness_desc">控制 RCAS/NIS/CAS 类锐化强度。</string>
    <string name="param_gpu_strength">GPU 增强强度</string>
    <string name="param_gpu_strength_desc">控制非缩放增强处理的强度。</string>
    <string name="param_fps_counter">悬浮层 FPS 计数器</string>
    <string name="param_fps_counter_desc">在悬浮层左上角显示 FPS。</string>
