    <string name="section_trusted_overlay">触控穿透</string>
    <string name="param_trusted_overlay">可信悬浮层（无障碍）</string>
    <string name="param_trusted_overlay_desc">通过无障碍服务托管悬浮层，使严格限制触控的设备也能把点击传递给下方应用。会话期间可能覆盖状态栏和导航栏。仅在普通模式无法触控穿透时启用。</string>
    <string name="section_capture_mode">捕获模式</string>
    <string name="capture_mode_mediaprojection">MediaProjection</string>
    <string name="capture_mode_shizuku">Shizuku 捕获</string>
    <string name="capture_mode_root">Root 捕获</string>
    <string name="capture_mode_desc">MediaProjection 使用 Android 屏幕共享捕获；Shizuku 和 Root 模式通过特权 UID 过滤路径捕获目标应用。</string>
    <string name="param_frame_graph">帧节奏图</string>
    <string name="param_frame_graph_desc">在悬浮层显示实时帧间隔曲线，用于排查卡顿。</string>
    <string name="dll_status_none">尚未选择 Lossless.dll。</string>
    <string name="dll_status_ready">Lossless.dll 已就绪（%1$s）。</string>
    <string name="dll_pick_button">选择 Lossless.dll</string>
    <string name="dll_reextract_button">重新提取着色器</string>
    <string name="param_multiplier">帧倍增倍率</string>
    <string name="param_multiplier_desc">每个真实帧对应的输出帧数。2 倍表示在两帧之间插入一帧；移动设备建议使用 3–4 倍。</string>
    <string name="param_flow_scale">光流缩放</string>
    <string name="param_flow_scale_desc">内部运动估计分辨率。数值越低速度越快，但精度越低。</string>
    <string name="param_performance_mode">性能模式（LSFG 3.1P）</string>
    <string name="param_performance_mode_desc">使用速度更快但质量略低的着色器版本，推荐中端 GPU 使用。</string>
    <string name="param_hdr">HDR 模式</string>
    <string name="param_hdr_desc">仅在设备和游戏均输出 HDR 时启用。</string>
    <string name="param_anti_artifacts">抗伪影模式</string>
    <string name="param_anti_artifacts_desc">在镜头快速移动时抑制生成帧，以减少角色缺失、扭曲等问题。默认关闭。</string>
    <string name="param_framegen_fp16">FP16 帧生成着色器</string>
    <string name="param_framegen_fp16_desc">使用 Lossless.dll 中预编译的半精度着色器，降低 GPU 负载和显存带宽；失败时会自动回退到 FP32。</string>
    <string name="param_npu_post">NPU 图像增强</string>
    <string name="param_npu_post_desc_available">在专用加速器上运行 NNAPI 图像增强。设备：%1$s</string>
    <string name="param_npu_post_desc_unavailable">Android 未检测到专用 NNAPI 加速器，因此已禁用。设备：%1$s</string>
    <string name="param_npu_preset">NPU 预设</string>
    <string name="npu_preset_off">关闭</string>
    <string name="npu_preset_sharpen">锐化</string>
    <string name="npu_preset_detail_boost">细节增强</string>
    <string name="npu_preset_chroma_clean">色度清理</string>
    <string name="npu_preset_game_crisp">游戏清晰</string>
    <string name="param_npu_amount">NPU 强度</string>
    <string name="param_npu_amount_desc">增强内核强度。数值越高画面越清晰，但可能放大压缩伪影。</string>
    <string name="param_npu_radius">NPU 半径</string>
    <string name="param_npu_radius_desc">反锐化遮罩使用的模糊半径。较大半径突出宽边缘，较小半径针对细节。</string>
    <string name="param_npu_upscale">NPU 放大倍率</string>
    <string name="param_npu_upscale_desc">1 倍保持输出尺寸；2 倍先执行 NPU 双线性放大再增强。</string>
    <string name="param_cpu_post">CPU 后处理</string>
    <string name="param_cpu_post_desc">在 NPU 阶段之后执行的 CPU 像素处理，可调饱和度、自然饱和度和暗角。</string>
    <string name="param_cpu_preset">CPU 预设</string>
    <string name="cpu_preset_off">关闭</string>
    <string name="cpu_preset_enhance_lut">增强</string>
    <string name="cpu_preset_warm">暖色</string>
    <string name="cpu_preset_cool">冷色</string>
    <string name="cpu_preset_vignette">暗角</string>
    <string name="cpu_preset_gamer_sharp">游戏锐化</string>
    <string name="cpu_preset_cinematic">电影感</string>
    <string name="param_cpu_strength">CPU 强度</string>
    <string name="param_cpu_strength_desc">控制当前 CPU 预设的主要强度，例如对比度增强、锐化幅度或电影感混合比例。</string>
    <string name="param_cpu_saturation">饱和度</string>
    <string name="param_cpu_saturation_desc">0 表示完全去色，50% 为中性，100% 会让颜色更加鲜艳。</string>
    <string name="param_cpu_vibrance">自然饱和度</string>
    <string name="param_cpu_vibrance_desc">提升低饱和度区域，同时避免过度增强本来就鲜艳的颜色，适合改善灰暗 HUD 和肤色。</string>
    <string name="param_cpu_vignette">暗角</string>
    <string name="param_cpu_vignette_desc">从画面半径约 60% 的位置开始，以余弦曲线逐渐压暗四角。</string>
    <string name="param_gpu_post">GPU 放大/增强</string>
    <string name="param_gpu_post_desc">使用 Vulkan GPU 后处理进行图像缩放和增强。</string>
    <string name="param_gpu_stage">GPU 处理顺序</string>
    <string name="gpu_stage_before_lsfg">先处理真实帧</string>
    <string name="gpu_stage_after_lsfg">处理最终悬浮层帧</string>
