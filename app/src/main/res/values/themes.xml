<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme -->
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryVariant">@color/colorPrimaryDark</item>
        <item name="colorOnPrimary">@color/colorWhite</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/colorAccent</item>
        <item name="colorSecondaryVariant">@color/colorAccentLight</item>
        <item name="colorOnSecondary">@color/colorBlack</item>
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/colorPrimaryDark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23">false</item>
        <!-- Navigation bar color -->
        <item name="android:navigationBarColor" tools:targetApi="27">@color/colorWhite</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <!-- Base colors -->
        <item name="android:windowBackground">@color/colorBackground</item>
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="android:textColorSecondary">@color/colorTextSecondary</item>
        <!-- Material theme attributes -->
        <item name="materialButtonStyle">@style/Widget.MyApplication.Button</item>
        <item name="textInputStyle">@style/Widget.MyApplication.TextInputLayout</item>
        <item name="cardViewStyle">@style/Widget.MyApplication.CardView</item>
        <item name="bottomNavigationStyle">@style/Widget.MyApplication.BottomNavigationView</item>
        <!-- Other attributes - removing font references temporarily -->
        <!-- <item name="android:fontFamily">@font/open_sans</item> -->
        <!-- <item name="fontFamily">@font/open_sans</item> -->
    </style>
    
    <!-- Splash screen theme -->
    <style name="Theme.MyApplication.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/colorBackground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.MyApplication</item>
    </style>
    
    <!-- Dialog theme -->
    <style name="Theme.MyApplication.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="android:background">@color/colorCardBackground</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.MyApplication.Button.TextButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.MyApplication.Button.TextButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.MyApplication.Button.TextButton</item>
    </style>
    
    <!-- Bottom Sheet Dialog theme -->
    <style name="Theme.MyApplication.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.MyApplication.BottomSheet</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:textColorPrimary">@color/colorTextPrimary</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    
    <!-- Button Styles -->
    <style name="Widget.MyApplication.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/colorWhite</item>
        <item name="android:textSize">@dimen/_16ssp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">@dimen/_24sdp</item>
        <item name="android:paddingEnd">@dimen/_24sdp</item>
        <item name="android:paddingTop">@dimen/_12sdp</item>
        <item name="android:paddingBottom">@dimen/_12sdp</item>
        <item name="cornerRadius">@dimen/_8sdp</item>
        <item name="elevation">@dimen/_2sdp</item>
    </style>
    
    <style name="Widget.MyApplication.Button.TextButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">@dimen/_14ssp</item>
        <item name="android:textAllCaps">false</item>
        <item name="rippleColor">@color/colorPrimaryLight</item>
    </style>
    
    <style name="Widget.MyApplication.Button.TextButton.Small" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">@dimen/_8sdp</item>
        <item name="android:paddingEnd">@dimen/_8sdp</item>
        <item name="android:paddingTop">@dimen/_4sdp</item>
        <item name="android:paddingBottom">@dimen/_4sdp</item>
        <item name="rippleColor">@color/colorPrimaryLight</item>
    </style>
    
    <style name="Widget.MyApplication.Button.OutlinedButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textSize">@dimen/_16ssp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/_8sdp</item>
        <item name="strokeColor">@color/colorPrimary</item>
        <item name="strokeWidth">@dimen/_1sdp</item>
    </style>

    <style name="Widget.MyApplication.ProgressBar.Horizontal" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:indeterminate">false</item>
        <item name="android:minHeight">@dimen/_12sdp</item>
        <item name="android:maxHeight">@dimen/_12sdp</item>
        <item name="android:progressDrawable">@drawable/progress_bar_drawable</item>
    </style>
    
    <!-- Chip Styles -->
    <style name="Widget.MyApplication.Chip.Filter" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_background_color</item>
        <item name="android:textColor">@color/chip_text_color</item>
        <item name="chipStrokeColor">@color/colorPrimary</item>
        <item name="chipStrokeWidth">@dimen/_1sdp</item>
        <item name="chipMinHeight">@dimen/_32sdp</item>
        <item name="android:textSize">@dimen/_14ssp</item>
    </style>
    
    <style name="Widget.MyApplication.Chip.Info" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipBackgroundColor">@color/colorPrimaryLight</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipMinHeight">@dimen/_24sdp</item>
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="chipIconTint">@color/colorPrimary</item>
    </style>
    
    <!-- Text Input Layout Styles -->
    <style name="Widget.MyApplication.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/colorPrimary</item>
        <item name="hintTextColor">@color/colorPrimary</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/_8sdp</item>
        <item name="boxCornerRadiusBottomStart">@dimen/_8sdp</item>
        <item name="boxCornerRadiusTopEnd">@dimen/_8sdp</item>
        <item name="boxCornerRadiusTopStart">@dimen/_8sdp</item>
        <item name="errorTextColor">@color/colorError</item>
    </style>
    
    <!-- Card View Style -->
    <style name="Widget.MyApplication.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/colorCardBackground</item>
        <item name="cardCornerRadius">@dimen/_12sdp</item>
        <item name="cardElevation">@dimen/_4sdp</item>
        <item name="contentPadding">@dimen/_16sdp</item>
        <item name="android:layout_margin">@dimen/_8sdp</item>
    </style>
    
    <!-- Bottom Navigation Style -->
    <style name="Widget.MyApplication.BottomNavigationView" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_item_color</item>
        <item name="itemTextColor">@color/bottom_nav_item_color</item>
        <item name="itemRippleColor">@color/colorPrimaryLight</item>
        <item name="elevation">@dimen/_8sdp</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>
    
    <!-- Bottom Sheet Style -->
    <style name="Widget.MyApplication.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@color/colorCardBackground</item>
        <item name="shapeAppearance">@style/ShapeAppearance.MyApplication.LargeComponent</item>
        <item name="behavior_peekHeight">@dimen/_512sdp</item>
    </style>
    
    <!-- Shape Appearance for Large Components -->
    <style name="ShapeAppearance.MyApplication.LargeComponent" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">@dimen/_16sdp</item>
        <item name="cornerSizeTopRight">@dimen/_16sdp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    
    <!-- Text Appearance Styles -->
    <style name="TextAppearance.MyApplication.Headline1" parent="TextAppearance.MaterialComponents.Headline1">
        <!-- <item name="fontFamily">@font/open_sans_light</item>
        <item name="android:fontFamily">@font/open_sans_light</item> -->
        <item name="android:textSize">@dimen/_32ssp</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>
    
    <style name="TextAppearance.MyApplication.Headline2" parent="TextAppearance.MaterialComponents.Headline2">
        <!-- <item name="fontFamily">@font/open_sans</item>
        <item name="android:fontFamily">@font/open_sans</item> -->
        <item name="android:textSize">@dimen/_24ssp</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>
    
    <style name="TextAppearance.MyApplication.Headline3" parent="TextAppearance.MaterialComponents.Headline3">
        <!-- <item name="fontFamily">@font/open_sans_semibold</item>
        <item name="android:fontFamily">@font/open_sans_semibold</item> -->
        <item name="android:textSize">@dimen/_20ssp</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>
    
    <style name="TextAppearance.MyApplication.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <!-- <item name="fontFamily">@font/open_sans</item>
        <item name="android:fontFamily">@font/open_sans</item> -->
        <item name="android:textSize">@dimen/_16ssp</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>
    
    <style name="TextAppearance.MyApplication.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <!-- <item name="fontFamily">@font/open_sans</item>
        <item name="android:fontFamily">@font/open_sans</item> -->
        <item name="android:textSize">@dimen/_14ssp</item>
        <item name="android:textColor">@color/colorTextSecondary</item>
    </style>
    
    <style name="TextAppearance.MyApplication.Subtitle1" parent="TextAppearance.MaterialComponents.Subtitle1">
        <!-- <item name="fontFamily">@font/open_sans_semibold</item>
        <item name="android:fontFamily">@font/open_sans_semibold</item> -->
        <item name="android:textSize">@dimen/_16ssp</item>
        <item name="android:textColor">@color/colorTextPrimary</item>
    </style>
    
    <style name="TextAppearance.MyApplication.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <!-- <item name="fontFamily">@font/open_sans</item>
        <item name="android:fontFamily">@font/open_sans</item> -->
        <item name="android:textSize">@dimen/_12ssp</item>
        <item name="android:textColor">@color/colorTextTertiary</item>
    </style>
    
    <style name="TextAppearance.MyApplication.Button" parent="TextAppearance.MaterialComponents.Button">
        <!-- <item name="fontFamily">@font/open_sans_semibold</item>
        <item name="android:fontFamily">@font/open_sans_semibold</item> -->
        <item name="android:textSize">@dimen/_14ssp</item>
        <item name="android:textColor">@color/colorWhite</item>
        <item name="android:textAllCaps">false</item>
    </style>
    
    <!-- No Action Bar Theme -->
    <style name="Theme.MyApplication.NoActionBar" parent="Theme.MyApplication">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>