<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:clipToPadding="false"
    android:paddingBottom="24dp"
    tools:context=".ui.gait.GaitFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_gait_overview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardUseCompatPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gait_header"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/tv_gait_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans_semibold"
                    android:text="@string/gait_overview_title"
                    android:textColor="@color/colorTextOnPrimary"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tv_gait_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/open_sans"
                    android:text="@string/gait_overview_description"
                    android:textColor="@color/colorTextOnPrimary"
                    android:textSize="14sp"
                    android:alpha="0.9" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_gait_score"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/opensans_bold"
                            android:text="82"
                            android:textColor="@color/colorTextOnPrimary"
                            android:textSize="42sp"
                            tools:text="82" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/open_sans"
                            android:text="@string/gait_overview_score_label"
                            android:textColor="@color/colorTextOnPrimary"
                            android:textSize="12sp"
                            android:alpha="0.9" />
                    </LinearLayout>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_gait_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/open_sans_semibold"
                            android:text="@string/gait_status_balanced"
                            android:textColor="@color/colorTextOnPrimary"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/tv_gait_status_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/open_sans"
                            android:text="@string/gait_status_hint"
                            android:textColor="@color/colorTextOnPrimary"
                            android:textSize="13sp"
                            android:alpha="0.85" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_refresh_gait"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/refresh_gait_data"
            app:icon="@drawable/ic_sync"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/colorPrimary" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_gait_metrics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans_semibold"
                    android:text="@string/gait_metric_section"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="16sp" />

                <androidx.gridlayout.widget.GridLayout
                    android:id="@+id/grid_metrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:alignmentMode="alignBounds"
                    android:columnCount="2">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_metric_speed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tv_metric_speed_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/open_sans_semibold"
                                android:text="@string/gait_metric_speed"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_metric_speed_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/opensans_bold"
                                android:text="1.15 m/s"
                                android:textColor="@color/colorPrimary"
                                android:textSize="20sp"
                                tools:text="1.12 m/s" />

                            <TextView
                                android:id="@+id/tv_metric_speed_trend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/open_sans"
                                android:text="@string/gait_metric_trend_placeholder"
                                android:textColor="@color/colorTextSecondary"
                                android:textSize="12sp"
                                tools:text="较昨日 +5%" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_metric_cadence"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tv_metric_cadence_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/open_sans_semibold"
                                android:text="@string/gait_metric_cadence"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_metric_cadence_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/opensans_bold"
                                android:text="110 步/分"
                                android:textColor="@color/colorPrimary"
                                android:textSize="20sp"
                                tools:text="108 步/分" />

                            <TextView
                                android:id="@+id/tv_metric_cadence_trend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/open_sans"
                                android:text="@string/gait_metric_trend_placeholder"
                                android:textColor="@color/colorTextSecondary"
                                android:textSize="12sp"
                                tools:text="较昨日 -2%" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_metric_stride"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tv_metric_stride_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/open_sans_semibold"
                                android:text="@string/gait_metric_stride"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_metric_stride_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/opensans_bold"
                                android:text="1.12 m"
                                android:textColor="@color/colorPrimary"
                                android:textSize="20sp"
                                tools:text="1.05 m" />

                            <TextView
                                android:id="@+id/tv_metric_stride_trend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/open_sans"
                                android:text="@string/gait_metric_trend_placeholder"
                                android:textColor="@color/colorTextSecondary"
                                android:textSize="12sp"
                                tools:text="保持稳定" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_metric_symmetry"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tv_metric_symmetry_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/open_sans_semibold"
                                android:text="@string/gait_metric_symmetry"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_metric_symmetry_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/opensans_bold"
                                android:text="92 %"
                                android:textColor="@color/colorPrimary"
                                android:textSize="20sp"
                                tools:text="89 %" />

                            <TextView
                                android:id="@+id/tv_metric_symmetry_trend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/open_sans"
                                android:text="@string/gait_metric_trend_placeholder"
                                android:textColor="@color/colorTextSecondary"
                                android:textSize="12sp"
                                tools:text="较昨日 +3%" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_metric_stance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tv_metric_stance_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/open_sans_semibold"
                                android:text="@string/gait_metric_stance"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_metric_stance_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/opensans_bold"
                                android:text="0.62 s"
                                android:textColor="@color/colorPrimary"
                                android:textSize="20sp"
                                tools:text="0.58 s" />

                            <TextView
                                android:id="@+id/tv_metric_stance_trend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/open_sans"
                                android:text="@string/gait_metric_trend_placeholder"
                                android:textColor="@color/colorTextSecondary"
                                android:textSize="12sp"
                                tools:text="较昨日 -1%" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/card_metric_variability"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        android:layout_rowWeight="1"
                        android:layout_columnWeight="1"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="2dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/tv_metric_variability_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/open_sans_semibold"
                                android:text="@string/gait_metric_variability"
                                android:textColor="@color/colorTextPrimary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/tv_metric_variability_value"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:fontFamily="@font/opensans_bold"
                                android:text="2.8 %"
                                android:textColor="@color/colorPrimary"
                                android:textSize="20sp"
                                tools:text="2.5 %" />

                            <TextView
                                android:id="@+id/tv_metric_variability_trend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/open_sans"
                                android:text="@string/gait_metric_trend_placeholder"
                                android:textColor="@color/colorTextSecondary"
                                android:textSize="12sp"
                                tools:text="较昨日 -0.4%" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </androidx.gridlayout.widget.GridLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_activity_recognition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans_semibold"
                    android:text="@string/gait_activity_section"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_activity_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/open_sans"
                    android:text="@string/gait_activity_hint"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="13sp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_activity_types"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:singleLine="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_gait_insights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans_semibold"
                    android:text="@string/gait_analysis_section"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_gait_insights"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/open_sans"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/gait_analysis_placeholder"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="14sp"
                    tools:text="• 步速保持稳定，建议维持当前训练频率\n• 左右步态对称度良好，暂无异常" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_gait_timeline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans_semibold"
                    android:text="@string/gait_timeline_section"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/container_gait_timeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tv_timeline_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/open_sans"
                    android:text="@string/gait_timeline_empty"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_fall_detection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardUseCompatPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/open_sans_semibold"
                    android:text="@string/gait_fall_section"
                    android:textColor="@color/colorTextPrimary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tv_fall_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/open_sans_semibold"
                    android:text="@string/gait_fall_status_stable"
                    android:textColor="@color/colorSuccess"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tv_fall_probability"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/open_sans"
                    android:text="@string/gait_fall_probability"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="14sp"
                    tools:text="跌倒概率：12%" />

                <TextView
                    android:id="@+id/tv_fall_last_event"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/open_sans"
                    android:text="@string/gait_fall_last_event"
                    android:textColor="@color/colorTextSecondary"
                    android:textSize="14sp"
                    tools:text="上次异常：2023/08/16 21:30" />

                <TextView
                    android:id="@+id/tv_fall_recommendation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_info_banner"
                    android:fontFamily="@font/open_sans"
                    android:padding="12dp"
                    android:text="@string/gait_fall_recommendation"
                    android:textColor="@color/colorInfo"
                    android:textSize="14sp"
                    tools:text="建议：睡前拉伸缓解肌肉紧张" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
