<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:overScrollMode="never"
    tools:context=".ui.health.HealthFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <!-- Header section -->
        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="健康监测"
            android:textAppearance="@style/TextAppearance.MyApplication.Headline2"
            app:layout_constraintEnd_toStartOf="@+id/btn_settings"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_header_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="跟踪您的健康状况，掌握身体变化"
            android:textAppearance="@style/TextAppearance.MyApplication.Body2"
            android:textColor="@color/colorTextSecondary"
            app:layout_constraintEnd_toEndOf="@+id/tv_header_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_header_title" />

        <ImageButton
            android:id="@+id/btn_settings"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="设置"
            android:src="@drawable/ic_notification"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/colorPrimary" />

        <!-- Health overview card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_health_overview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/colorSurface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_header_subtitle"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_health_overview_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="健康数据"
                    android:textAppearance="@style/TextAppearance.MyApplication.Subtitle1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_health_overview_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="今日更新"
                    android:textAppearance="@style/TextAppearance.MyApplication.Caption"
                    android:textColor="@color/colorSuccess"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_health_overview_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_health_overview_title" />

                <!-- Health metrics grid -->
                <androidx.gridlayout.widget.GridLayout
                    android:id="@+id/grid_health_metrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:columnCount="3"
                    app:layout_constraintTop_toBottomOf="@+id/tv_health_overview_title"
                    app:rowCount="2">

                    <!-- Heart Rate -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_rounded"
                        android:padding="12dp"
                        app:layout_columnWeight="1"
                        android:layout_margin="4dp">

                        <ImageView
                            android:id="@+id/iv_heart_rate_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_health"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/colorPrimary" />

                        <TextView
                            android:id="@+id/tv_heart_rate_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="心率"
                            android:textAppearance="@style/TextAppearance.MyApplication.Caption"
                            android:textColor="@color/colorTextSecondary"
                            app:layout_constraintBottom_toBottomOf="@+id/iv_heart_rate_icon"
                            app:layout_constraintStart_toEndOf="@+id/iv_heart_rate_icon"
                            app:layout_constraintTop_toTopOf="@+id/iv_heart_rate_icon" />

                        <TextView
                            android:id="@+id/tv_heart_rate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="75"
                            android:textAppearance="@style/TextAppearance.MyApplication.Headline3"
                            android:textColor="@color/colorTextPrimary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/iv_heart_rate_icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="BPM"
                            android:textAppearance="@style/TextAppearance.MyApplication.Caption"
                            android:textColor="@color/colorTextTertiary"
                            app:layout_constraintBaseline_toBaselineOf="@+id/tv_heart_rate"
                            app:layout_constraintStart_toEndOf="@+id/tv_heart_rate" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Blood Pressure -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_rounded"
                        android:padding="12dp"
                        app:layout_columnWeight="1"
                        android:layout_margin="4dp">

                        <ImageView
                            android:id="@+id/iv_blood_pressure_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_health"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/colorAccent" />

                        <TextView
                            android:id="@+id/tv_blood_pressure_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="血压"
                            android:textAppearance="@style/TextAppearance.MyApplication.Caption"
                            android:textColor="@color/colorTextSecondary"
                            app:layout_constraintBottom_toBottomOf="@+id/iv_blood_pressure_icon"
                            app:layout_constraintStart_toEndOf="@+id/iv_blood_pressure_icon"
                            app:layout_constraintTop_toTopOf="@+id/iv_blood_pressure_icon" />

                        <TextView
                            android:id="@+id/tv_blood_pressure"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="120/80"
                            android:textAppearance="@style/TextAppearance.MyApplication.Headline3"
                            android:textColor="@color/colorTextPrimary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/iv_blood_pressure_icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="mmHg"
                            android:textAppearance="@style/TextAppearance.MyApplication.Caption"
                            android:textColor="@color/colorTextTertiary"
                            app:layout_constraintBaseline_toBaselineOf="@+id/tv_blood_pressure"
                            app:layout_constraintStart_toEndOf="@+id/tv_blood_pressure" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Blood Oxygen -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_rounded"
                        android:padding="12dp"
                        app:layout_columnWeight="1"
                        android:layout_margin="4dp">

                        <ImageView
                            android:id="@+id/iv_blood_sugar_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_health"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/colorInfo" />

                        <TextView
                            android:id="@+id/tv_blood_sugar_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="血糖"
                            android:textAppearance="@style/TextAppearance.MyApplication.Caption"
                            android:textColor="@color/colorTextSecondary"
                            app:layout_constraintBottom_toBottomOf="@+id/iv_blood_sugar_icon"
                            app:layout_constraintStart_toEndOf="@+id/iv_blood_sugar_icon"
                            app:layout_constraintTop_toTopOf="@+id/iv_blood_sugar_icon" />

                        <TextView
                            android:id="@+id/tv_blood_sugar"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="98"
                            android:textAppearance="@style/TextAppearance.MyApplication.Headline3"
                            android:textColor="@color/colorTextPrimary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/iv_blood_sugar_icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="%"
                            android:textAppearance="@style/TextAppearance.MyApplication.Caption"
                            android:textColor="@color/colorTextTertiary"
                            app:layout_constraintBaseline_toBaselineOf="@+id/tv_blood_sugar"
                            app:layout_constraintStart_toEndOf="@+id/tv_blood_sugar" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- BMI -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_rounded"
                        android:padding="12dp"
                        app:layout_columnWeight="1"
                        android:layout_margin="4dp">

                        <ImageView
                            android:id="@+id/iv_bmi_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_bmi"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/colorPrimary" />

                        <TextView
                            android:id="@+id/tv_bmi_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="BMI"
                            android:textAppearance="@style/TextAppearance.MyApplication.Caption"
                            android:textColor="@color/colorTextSecondary"
                            app:layout_constraintBottom_toBottomOf="@id/iv_bmi_icon"
                            app:layout_constraintStart_toEndOf="@id/iv_bmi_icon"
                            app:layout_constraintTop_toTopOf="@id/iv_bmi_icon" />

                        <TextView
                            android:id="@+id/tv_bmi"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="22.5"
                            android:textAppearance="@style/TextAppearance.MyApplication.Headline3"
                            android:textColor="@color/colorTextPrimary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/iv_bmi_icon" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Steps -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_rounded"
                        android:padding="12dp"
                        app:layout_columnWeight="1"
                        android:layout_margin="4dp">

                        <ImageView
                            android:id="@+id/iv_steps_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_steps"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/colorAccent" />

                        <TextView
                            android:id="@+id/tv_steps_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="步数"
                            android:textAppearance="@style/TextAppearance.MyApplication.Caption"
                            android:textColor="@color/colorTextSecondary"
                            app:layout_constraintBottom_toBottomOf="@id/iv_steps_icon"
                            app:layout_constraintStart_toEndOf="@id/iv_steps_icon"
                            app:layout_constraintTop_toTopOf="@id/iv_steps_icon" />

                        <TextView
                            android:id="@+id/tv_steps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="0"
                            android:textAppearance="@style/TextAppearance.MyApplication.Headline3"
                            android:textColor="@color/colorTextPrimary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/iv_steps_icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="步"
                            android:textAppearance="@style/TextAppearance.MyApplication.Caption"
                            android:textColor="@color/colorTextTertiary"
                            app:layout_constraintBaseline_toBaselineOf="@id/tv_steps"
                            app:layout_constraintStart_toEndOf="@id/tv_steps" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- Sleep -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_rounded"
                        android:padding="12dp"
                        app:layout_columnWeight="1"
                        android:layout_margin="4dp">

                        <ImageView
                            android:id="@+id/iv_sleep_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_sleep"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="@color/colorInfo" />

                        <TextView
                            android:id="@+id/tv_sleep_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="睡眠"
                            android:textAppearance="@style/TextAppearance.MyApplication.Caption"
                            android:textColor="@color/colorTextSecondary"
                            app:layout_constraintBottom_toBottomOf="@id/iv_sleep_icon"
                            app:layout_constraintStart_toEndOf="@id/iv_sleep_icon"
                            app:layout_constraintTop_toTopOf="@id/iv_sleep_icon" />

                        <TextView
                            android:id="@+id/tv_sleep"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="7"
                            android:textAppearance="@style/TextAppearance.MyApplication.Headline3"
                            android:textColor="@color/colorTextPrimary"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/iv_sleep_icon" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="h"
                            android:textAppearance="@style/TextAppearance.MyApplication.Caption"
                            android:textColor="@color/colorTextTertiary"
                            app:layout_constraintBaseline_toBaselineOf="@id/tv_sleep"
                            app:layout_constraintStart_toEndOf="@id/tv_sleep" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.gridlayout.widget.GridLayout>

                <!-- Action buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="end"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@+id/grid_health_metrics">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_add_custom_indicator"
                        style="@style/Widget.MyApplication.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="添加自定义指标"
                        app:icon="@drawable/ic_task"
                        app:iconGravity="textStart"
                        app:iconTint="@color/colorPrimary" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_update_health_data"
                        style="@style/Widget.MyApplication.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="更新数据"
                        app:icon="@drawable/ic_refresh"
                        app:iconGravity="textStart"
                        app:iconTint="@color/colorPrimary" />
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Health trends section -->
        <TextView
            android:id="@+id/tv_trends_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="健康趋势"
            android:textAppearance="@style/TextAppearance.MyApplication.Headline3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_health_overview" />

        <TextView
            android:id="@+id/tv_trends_timeframe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="本周"
            android:textAppearance="@style/TextAppearance.MyApplication.Caption"
            android:textColor="@color/colorPrimary"
            app:layout_constraintBottom_toBottomOf="@+id/tv_trends_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_trends_title" />

        <Spinner
            android:id="@+id/spinner_trend_metric"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/spinner_background"
            app:layout_constraintBottom_toBottomOf="@+id/tv_trends_title"
            app:layout_constraintEnd_toStartOf="@id/tv_trends_timeframe"
            app:layout_constraintTop_toTopOf="@+id/tv_trends_title" />

        <!-- Chart card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_chart"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/colorSurface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_trends_title"
            app:strokeWidth="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">

                <!-- Real chart view -->
                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chart_health_trend"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Health report card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_health_report"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/colorSurface"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:layout_constraintTop_toBottomOf="@+id/card_chart"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_report_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="健康报告"
                    android:textAppearance="@style/TextAppearance.MyApplication.Subtitle1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_health_report"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card_rounded"
                    android:padding="16dp"
                    android:text="您的健康状况良好，各项指标在正常范围内。建议保持规律作息，适量运动，均衡饮食。"
                    android:textAppearance="@style/TextAppearance.MyApplication.Body2"
                    android:textColor="@color/colorTextSecondary"
                    app:layout_constraintTop_toBottomOf="@+id/tv_report_title" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_view_report"
                    style="@style/Widget.MyApplication.Button"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="查看完整报告"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_arrow_right"
                    app:iconGravity="end"
                    app:layout_constraintTop_toBottomOf="@+id/tv_health_report" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Custom indicators section -->
        <TextView
            android:id="@+id/tv_custom_indicators_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="自定义指标"
            android:textAppearance="@style/TextAppearance.MyApplication.Headline3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_health_report" />

        <!-- 添加无指标提示文本 -->
        <TextView
            android:id="@+id/tv_no_indicators"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="暂无自定义健康指标"
            android:textAppearance="@style/TextAppearance.MyApplication.Body2"
            android:textColor="@color/colorTextSecondary"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/tv_custom_indicators_title" />

        <!-- 添加自定义指标容器 -->
        <LinearLayout
            android:id="@+id/container_custom_indicators"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@+id/tv_custom_indicators_title">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_custom_indicators"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:orientation="vertical"
                android:overScrollMode="never"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="2"
                tools:listitem="@layout/item_custom_indicator" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView> 