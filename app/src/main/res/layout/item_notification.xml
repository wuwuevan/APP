<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <!-- 通知图标 -->
    <ImageView
        android:id="@+id/iv_notification_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:src="@drawable/ic_notification"
        android:contentDescription="通知图标" />

    <!-- 通知内容 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/iv_notification_icon"
        android:layout_toStartOf="@id/iv_read_status"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical">

        <!-- 通知标题 -->
        <TextView
            android:id="@+id/tv_notification_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="通知标题"
            android:textSize="16sp"
            android:textColor="@color/colorTextPrimary"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- 通知内容 -->
        <TextView
            android:id="@+id/tv_notification_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="通知内容详情"
            android:textSize="14sp"
            android:textColor="@color/colorTextSecondary"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="4dp" />

        <!-- 通知时间 -->
        <TextView
            android:id="@+id/tv_notification_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2025-07-05 10:30"
            android:textSize="12sp"
            android:textColor="@color/colorTextTertiary"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- 未读状态指示器 -->
    <ImageView
        android:id="@+id/iv_read_status"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/bg_notification_count"
        android:contentDescription="未读状态" />

</RelativeLayout> 