<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_event_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="步态记录"
            android:textAppearance="@style/TextAppearance.MyApplication.Headline4"
            android:textColor="@color/colorTextPrimary" />

        <TextView
            android:id="@+id/tv_event_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="10:05 · 室内步行"
            android:textAppearance="@style/TextAppearance.MyApplication.Body1"
            android:textColor="@color/colorTextSecondary" />

        <TextView
            android:id="@+id/tv_event_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_status_normal"
            android:padding="4dp"
            android:text="正常"
            android:textAppearance="@style/TextAppearance.MyApplication.Caption"
            android:textColor="@color/colorSuccess" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
