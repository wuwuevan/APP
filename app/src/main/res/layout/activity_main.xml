<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".MainActivity">

    <!-- Status Bar Scrim for better transition -->
    <View
        android:id="@+id/status_bar_scrim"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:background="@color/colorPrimary"
        android:elevation="4dp"
        app:layout_constraintHeight_percent="0" />

    <!-- Custom Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorSurface"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/status_bar_scrim">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- App Logo for Home Screen -->
            <ImageView
                android:id="@+id/toolbar_logo"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_health"
                android:contentDescription="@string/app_name"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/colorPrimary" />

            <!-- Title for Other Screens -->
            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/open_sans_semibold"
                android:textColor="@color/colorTextPrimary"
                android:textSize="18sp"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Screen Title"
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.appcompat.widget.Toolbar>

    <!-- Main Content -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:defaultNavHost="true"
        app:layout_constraintBottom_toTopOf="@+id/nav_view"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:navGraph="@navigation/mobile_navigation" />

    <!-- Custom Bottom Navigation -->
    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/nav_toggle_group"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/colorSurface"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navigation_home"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:text="@string/home"
            android:textAllCaps="false"
            android:textColor="@color/bottom_nav_item_color"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            app:backgroundTint="@color/bottom_nav_button_background"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_home"
            app:iconGravity="textTop"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="@color/bottom_nav_item_color"
            app:rippleColor="@color/colorRipple"
            app:strokeColor="@color/bottom_nav_button_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navigation_gait"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:text="@string/gait"
            android:textAllCaps="false"
            android:textColor="@color/bottom_nav_item_color"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            app:backgroundTint="@color/bottom_nav_button_background"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_gait"
            app:iconGravity="textTop"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="@color/bottom_nav_item_color"
            app:rippleColor="@color/colorRipple"
            app:strokeColor="@color/bottom_nav_button_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navigation_health"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:text="@string/health"
            android:textAllCaps="false"
            android:textColor="@color/bottom_nav_item_color"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            app:backgroundTint="@color/bottom_nav_button_background"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_health"
            app:iconGravity="textTop"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="@color/bottom_nav_item_color"
            app:rippleColor="@color/colorRipple"
            app:strokeColor="@color/bottom_nav_button_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navigation_chat"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:text="@string/chat"
            android:textAllCaps="false"
            android:textColor="@color/bottom_nav_item_color"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            app:backgroundTint="@color/bottom_nav_button_background"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_chat"
            app:iconGravity="textTop"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="@color/bottom_nav_item_color"
            app:rippleColor="@color/colorRipple"
            app:strokeColor="@color/bottom_nav_button_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navigation_community"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:text="@string/community"
            android:textAllCaps="false"
            android:textColor="@color/bottom_nav_item_color"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            app:backgroundTint="@color/bottom_nav_button_background"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_community"
            app:iconGravity="textTop"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="@color/bottom_nav_item_color"
            app:rippleColor="@color/colorRipple"
            app:strokeColor="@color/bottom_nav_button_stroke"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/navigation_profile"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:text="@string/profile"
            android:textAllCaps="false"
            android:textColor="@color/bottom_nav_item_color"
            android:textAppearance="@style/TextAppearance.MaterialComponents.Caption"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            app:backgroundTint="@color/bottom_nav_button_background"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_person"
            app:iconGravity="textTop"
            app:iconPadding="0dp"
            app:iconSize="24dp"
            app:iconTint="@color/bottom_nav_item_color"
            app:rippleColor="@color/colorRipple"
            app:strokeColor="@color/bottom_nav_button_stroke"
            app:strokeWidth="1dp" />

    </com.google.android.material.button.MaterialButtonToggleGroup>

</androidx.constraintlayout.widget.ConstraintLayout>