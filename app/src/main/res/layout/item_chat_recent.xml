<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/colorSurface"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:rippleColor="@color/colorPrimaryLight"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Avatar/Icon -->
        <ImageView
            android:id="@+id/iv_chat_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circle_bg"
            android:padding="8dp"
            android:src="@drawable/ic_chat"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/colorPrimary" />

        <!-- Chat title and last message -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_chat_time"
            app:layout_constraintStart_toEndOf="@+id/iv_chat_avatar"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_chat_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.MyApplication.Subtitle1"
                android:textColor="@color/colorTextPrimary"
                tools:text="健康咨询" />

            <TextView
                android:id="@+id/tv_chat_last_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.MyApplication.Body2"
                android:textColor="@color/colorTextSecondary"
                tools:text="您好，我想咨询一下关于膝盖疼痛的问题" />
        </LinearLayout>

        <!-- Chat time -->
        <TextView
            android:id="@+id/tv_chat_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.MyApplication.Caption"
            android:textColor="@color/colorTextTertiary"
            app:layout_constraintEnd_toStartOf="@+id/iv_delete_chat"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="14:30" />

        <!-- Delete chat -->
        <ImageView
            android:id="@+id/iv_delete_chat"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/delete"
            android:padding="2dp"
            android:src="@android:drawable/ic_delete"
            android:tint="@color/colorError"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Unread indicator (optional) -->
        <TextView
            android:id="@+id/tv_unread_count"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:background="@drawable/bg_notification_count"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.MyApplication.Caption"
            android:textColor="@color/colorWhite"
            android:textSize="10sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="2"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView> 