<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:padding="24dp"
    tools:context=".ui.community.CommunityFragment">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_community_placeholder"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="32dp"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/iv_community_icon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_community"
                android:contentDescription="@string/community"
                app:tint="@color/colorPrimary" />

            <TextView
                android:id="@+id/tv_community_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/open_sans_semibold"
                android:text="@string/community_title"
                android:textColor="@color/colorTextPrimary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tv_community_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/open_sans"
                android:gravity="center"
                android:text="@string/community_description"
                android:textColor="@color/colorTextSecondary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:textAlignment="center"
                android:maxWidth="280dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_community_placeholder"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/community_action"
                app:icon="@drawable/ic_notification"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@color/colorPrimary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
